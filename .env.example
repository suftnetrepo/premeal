# Copy this file to .env and adjust if needed.
# Matches the default credentials in docker-compose.yml — works out of the box
# if you run `docker compose up -d` without changing anything.
DATABASE_URL="postgresql://premeal:premeal@localhost:5432/premeal"

# Only needed against a pooled connection (e.g. Neon's "-pooler" hostname,
# used as DATABASE_URL on Vercel/serverless — see prisma/schema.prisma).
# Same database, unpooled connection (Neon: same hostname without
# "-pooler"). `prisma migrate deploy` uses this instead of DATABASE_URL,
# since a transaction pooler doesn't support the advisory locks migrations
# need. Against a plain, unpooled Postgres (e.g. the local docker-compose
# one above), this can just be the same value as DATABASE_URL.
DIRECT_URL="postgresql://premeal:premeal@localhost:5432/premeal"


# Any long random string — used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Mapbox — used to turn typed addresses into coordinates for radius-based
# restaurant search. Free tier: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=""

# Cloudinary — used to upload and host menu item photos. Free tier:
# https://cloudinary.com/users/register/free
# Find these on your Cloudinary dashboard after signing up.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stripe — test mode keys, free to create at https://dashboard.stripe.com/test/apikeys
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` (see README) in dev, or
# your webhook endpoint's settings in the Stripe dashboard in production.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Used to build Stripe Connect onboarding return URLs — your local dev URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe subscriptions — create a recurring Price (e.g. £9.99/month) in
# your Stripe dashboard (test mode), then paste its ID here.
STRIPE_SUBSCRIPTION_PRICE_ID=""

# Brevo — used for admin broadcast emails and every transactional email
# (order confirmations, "you have a new order," etc.). Free tier:
# https://brevo.com
# WARNING: the exact spelling matters — BREVO, not a typo like BREVA.
# BREVO_FROM_EMAIL must be an address on a domain verified in your Brevo
# account (Brevo dashboard -> Senders, Domains & Dedicated IPs), or every
# send will fail.
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""

# Upstash Redis — optional. Without these, rate limiting falls back to an
# in-memory store (fine for local dev / a single server instance, not
# correct once this app runs on more than one). Free tier: https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Random secret protecting /api/cron/sweep — the serverless replacement
# for the local worker script. Generate with: openssl rand -hex 32
# Must match exactly between Vercel's env vars and the GitHub Actions
# secret that actually triggers it every 5 minutes (see
# .github/workflows/sweep.yml).
CRON_SECRET=""
